{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-vue"],
  "name": "我的项目 API 文档",
  "includeVersion": true,
  "cleanOutputDir": true,
  "exclude": ["**/node_modules/**", "**/*.spec.ts", "**/*.test.ts"]
}